// Paste INSIDE match /b/{bucket}/o in existing Firebase Storage rules.
function kmcStorageMember() {
  return request.auth != null && request.auth.token.get('memberId','') == request.auth.uid;
}
function kmcStorageChatAccess(chatId) {
  return kmcStorageMember() && (chatId == 'team' || request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants);
}
match /chatAttachments/{chatId}/{senderId}/{messageId}/{fileId} {
  allow create: if kmcStorageChatAccess(chatId) && senderId == request.auth.uid && fileId in ['0','1','2','3'] && request.resource.size > 0 && request.resource.size <= 10485760 &&
    request.resource.contentType is string && request.resource.contentType.size() <= 100;
  allow read: if kmcStorageChatAccess(chatId) && (senderId == request.auth.uid ||
    (firestore.exists(/databases/(default)/documents/chats/$(chatId)/messages/$(messageId)) &&
     firestore.get(/databases/(default)/documents/chats/$(chatId)/messages/$(messageId)).data.deleted == false));
  allow update: if false;
  allow delete: if kmcStorageChatAccess(chatId) && (senderId == request.auth.uid || request.auth.token.get('chatAdmin',false) == true || request.auth.token.get('admin',false) == true);
}

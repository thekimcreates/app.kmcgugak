// Replace the existing memberProfiles block inside /databases/{database}/documents.
// Do not replace your other website/chat/admin rules.
// This collection stores avatar images only; account data stays in its own collections.
match /memberProfiles/{memberId} {
  function signedMember() {
    return request.auth != null
      && request.auth.token.memberId == request.auth.uid;
  }
  function ownMemberProfile() {
    return signedMember() && request.auth.uid == memberId;
  }
  allow get, list: if signedMember();
  allow create, update: if ownMemberProfile()
    && request.resource.data.keys().hasOnly(['photoBase64'])
    && request.resource.data.photoBase64 is string
    && request.resource.data.photoBase64.size() <= 150000;
}

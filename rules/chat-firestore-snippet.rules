// Paste INSIDE match /databases/{database}/documents in existing Firestore rules.
// Preserve the website, admin, performance, and memberProfiles rules.
function kmcChatMember() {
  return request.auth != null && request.auth.token.get('memberId', '') == request.auth.uid;
}
function kmcChatAdmin() {
  return kmcChatMember() && (request.auth.token.get('chatAdmin', false) == true || request.auth.token.get('admin', false) == true || (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('active', false) == true));
}
function kmcChatAccess(chatId) {
  return kmcChatMember() && (chatId == 'team' || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
}
function kmcGroupParticipants(p) {
  return p is list &&
    p.size() >= 3 &&
    p.size() <= 50 &&
    p.toSet().size() == p.size() &&
    (p.size() <= 0 || (p[0] is string && p[0].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 1 || (p[1] is string && p[1].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 2 || (p[2] is string && p[2].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 3 || (p[3] is string && p[3].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 4 || (p[4] is string && p[4].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 5 || (p[5] is string && p[5].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 6 || (p[6] is string && p[6].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 7 || (p[7] is string && p[7].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 8 || (p[8] is string && p[8].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 9 || (p[9] is string && p[9].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 10 || (p[10] is string && p[10].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 11 || (p[11] is string && p[11].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 12 || (p[12] is string && p[12].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 13 || (p[13] is string && p[13].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 14 || (p[14] is string && p[14].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 15 || (p[15] is string && p[15].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 16 || (p[16] is string && p[16].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 17 || (p[17] is string && p[17].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 18 || (p[18] is string && p[18].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 19 || (p[19] is string && p[19].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 20 || (p[20] is string && p[20].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 21 || (p[21] is string && p[21].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 22 || (p[22] is string && p[22].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 23 || (p[23] is string && p[23].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 24 || (p[24] is string && p[24].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 25 || (p[25] is string && p[25].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 26 || (p[26] is string && p[26].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 27 || (p[27] is string && p[27].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 28 || (p[28] is string && p[28].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 29 || (p[29] is string && p[29].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 30 || (p[30] is string && p[30].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 31 || (p[31] is string && p[31].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 32 || (p[32] is string && p[32].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 33 || (p[33] is string && p[33].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 34 || (p[34] is string && p[34].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 35 || (p[35] is string && p[35].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 36 || (p[36] is string && p[36].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 37 || (p[37] is string && p[37].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 38 || (p[38] is string && p[38].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 39 || (p[39] is string && p[39].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 40 || (p[40] is string && p[40].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 41 || (p[41] is string && p[41].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 42 || (p[42] is string && p[42].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 43 || (p[43] is string && p[43].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 44 || (p[44] is string && p[44].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 45 || (p[45] is string && p[45].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 46 || (p[46] is string && p[46].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 47 || (p[47] is string && p[47].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 48 || (p[48] is string && p[48].matches('[a-z0-9_-]{3,100}'))) &&
    (p.size() <= 49 || (p[49] is string && p[49].matches('[a-z0-9_-]{3,100}')));
}

function kmcChatAttachment(a, chatId, messageId, index) {
  return a is map && a.keys().hasOnly(['path','name','mime','size']) &&
    a.path == 'chatAttachments/' + chatId + '/' + request.auth.uid + '/' + messageId + '/' + index &&
    a.name is string && a.name.size() > 0 && a.name.size() <= 255 &&
    a.mime is string && a.mime.size() > 0 && a.mime.size() <= 100 &&
    a.size is int && a.size > 0 && a.size <= 10485760;
}
function kmcChatFiles(a, chatId, messageId) {
  return a is list && a.size() <= 4 &&
    (a.size() < 1 || kmcChatAttachment(a[0],chatId,messageId,'0')) &&
    (a.size() < 2 || kmcChatAttachment(a[1],chatId,messageId,'1')) &&
    (a.size() < 3 || kmcChatAttachment(a[2],chatId,messageId,'2')) &&
    (a.size() < 4 || kmcChatAttachment(a[3],chatId,messageId,'3'));
}
function kmcChatReply(r,chatId) {
  return r == null || (r is map && r.keys().hasOnly(['id','name','text']) &&
    r.id is string && r.id.size() > 0 && r.id.size() <= 100 &&
    r.name is string && r.name.size() <= 80 && r.text is string && r.text.size() <= 160 &&
    exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(r.id)) &&
    r.name == get(/databases/$(database)/documents/chats/$(chatId)/messages/$(r.id)).data.senderName);
}
match /chatMembers/{memberId} {
  allow read: if kmcChatMember();
  allow create, update: if kmcChatMember() && request.auth.uid == memberId &&
    request.resource.data.keys().hasOnly(['displayName','photoBase64','admin']) &&
    request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 80 &&
    request.resource.data.photoBase64 is string && request.resource.data.photoBase64.size() <= 150000 && request.resource.data.admin == kmcChatAdmin();
  allow delete: if false;
}
match /chats/{chatId} {
  allow get: if kmcChatMember() && (!exists(/databases/$(database)/documents/chats/$(chatId)) || chatId == 'team' || request.auth.uid in resource.data.participants);
  allow list: if kmcChatMember() && (chatId == 'team' || request.auth.uid in resource.data.participants);
  allow create: if kmcChatMember() && request.resource.data.keys().hasOnly(['type','title','participants','lastMessage','lastSenderId','lastMessageId','updatedAt']) &&
    request.resource.data.lastMessage == '' && request.resource.data.lastSenderId == '' && request.resource.data.lastMessageId == '' && request.resource.data.updatedAt == request.time &&
    ((chatId == 'team' && request.resource.data.type == 'team' && request.resource.data.title == 'Team Chat' && request.resource.data.participants == []) ||
     (chatId.matches('dm_[A-Za-z0-9_-]+') && request.resource.data.type == 'dm' && request.resource.data.title == '' &&
      request.resource.data.participants is list && request.resource.data.participants.size() == 2 && request.auth.uid in request.resource.data.participants &&
      request.resource.data.participants[0] != request.resource.data.participants[1] &&
      request.resource.data.participants[0] is string && request.resource.data.participants[1] is string &&
      request.resource.data.participants[0].matches('[a-z0-9_-]{3,100}') && request.resource.data.participants[1].matches('[a-z0-9_-]{3,100}')) ||
     (chatId.matches('group_[A-Za-z0-9_-]+') && request.resource.data.type == 'group' &&
      request.resource.data.title is string && request.resource.data.title.size() <= 80 &&
      kmcGroupParticipants(request.resource.data.participants) && request.auth.uid in request.resource.data.participants));
  allow update: if kmcChatAccess(chatId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastSenderId','lastMessageId','updatedAt']) &&
    request.resource.data.updatedAt == request.time && request.resource.data.lastMessageId is string && request.resource.data.lastMessageId.size() > 0 &&
    request.resource.data.lastMessage == getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.preview &&
    request.resource.data.lastSenderId == getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.senderId &&
    ((getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.senderId == request.auth.uid &&
      getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.sentAt == request.time) ||
     (request.resource.data.lastMessageId == resource.data.lastMessageId && request.resource.data.lastMessage == 'Message removed' &&
      getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(resource.data.lastMessageId)).data.deleted == true && (kmcChatAdmin() || resource.data.lastSenderId == request.auth.uid)));
  allow delete: if false;
  match /messages/{messageId} {
    allow read: if kmcChatAccess(chatId);
    allow create: if kmcChatAccess(chatId) && request.resource.data.keys().hasOnly(['senderId','senderName','text','preview','admin','deleted','sentAt','attachments','reactions','reply']) &&
      request.resource.data.senderId == request.auth.uid && request.resource.data.senderName == get(/databases/$(database)/documents/chatMembers/$(request.auth.uid)).data.displayName &&
      request.resource.data.admin == kmcChatAdmin() && request.resource.data.deleted == false && request.resource.data.sentAt == request.time &&
      request.resource.data.text is string && request.resource.data.text.size() <= 4000 && request.resource.data.preview is string && request.resource.data.preview.size() <= 160 &&
      kmcChatFiles(request.resource.data.attachments,chatId,messageId) && (request.resource.data.text.size() > 0 || request.resource.data.attachments.size() > 0) &&
      request.resource.data.reactions == {} && kmcChatReply(request.resource.data.reply,chatId) &&
      getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessageId == messageId;
    allow update: if kmcChatAccess(chatId) && resource.data.deleted == false && (
      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) && request.resource.data.reactions is map &&
       request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid]) &&
       (!(request.auth.uid in request.resource.data.reactions) || request.resource.data.reactions[request.auth.uid] in ['❤️','👍','👏','🎉'])) ||
      ((resource.data.senderId == request.auth.uid || kmcChatAdmin()) &&
       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','text','preview','attachments','reactions','reply']) &&
       request.resource.data.deleted == true && request.resource.data.text == '' && request.resource.data.preview == 'Message removed' &&
       request.resource.data.attachments == [] && request.resource.data.reactions == {} && request.resource.data.reply == null));
    allow delete: if false;
  }
}
match /chatSettings/{memberId}/devices/{deviceId} {
  allow read, delete: if kmcChatMember() && request.auth.uid == memberId;
  allow create, update: if kmcChatMember() && request.auth.uid == memberId && request.resource.data.keys().hasOnly(['mode','permissionGranted','updatedAt']) &&
    request.resource.data.mode in ['all','admins','off'] && request.resource.data.permissionGranted is bool && request.resource.data.updatedAt == request.time;
}
match /chatReports/{reportId} {
  allow create: if kmcChatMember() && request.resource.data.keys().hasOnly(['chatId','messageId','reporterId','reason','createdAt']) &&
    request.resource.data.reporterId == request.auth.uid && request.resource.data.chatId is string && request.resource.data.messageId is string && kmcChatAccess(request.resource.data.chatId) &&
    exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(request.resource.data.messageId)) &&
    request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500 && request.resource.data.createdAt == request.time;
  allow read, delete: if kmcChatAdmin();
  allow update: if false;
}
